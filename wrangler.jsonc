{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "reconciliacao-stc",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-07",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  }
}
